{
  "name": "@retrojb/retro-mcps",
  "description": "mono repos for retrojb mcp tooling",
  "version": "0.0.0",
  "keywords": [
    "mcp",
    "ai"
  ],
  "homepage": "https://github.com/Retrojb/retrojb-mcps",
  "bugs": {
    "url": "https://github.com/Retrojb/retrojb-mcps",
    "email": "jbaltes89@gmail.com"
  },
  "repository": {
    "type": "github",
    "url": "git+https://github.com/Retrojb/retrojb-mcps"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "start:docs": "npm run start --workspace=@retrojb/docs",
    "check-types": "turbo run check-types",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "changeset:version": "changeset version && npm install --package-lock-only",
    "clean": "npm run clean --workspace=@retrojb/workspace-tools",
    "doctor": "npm run doctor --workspace=@retrojb/workspace-tools"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "prettier": "3.9.6",
    "turbo": "~2.10.12",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.6.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
