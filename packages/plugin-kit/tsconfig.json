{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    // No DOM and no @types/node: this code runs inside a Figma plugin sandbox
    // and a plugin iframe, so it must not reach for host-specific globals.
    "lib": ["ES2020"],
    "types": [],
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
