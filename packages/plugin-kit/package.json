{
  "name": "@retrojb/plugin-kit",
  "version": "0.0.0",
  "description": "Transport primitives shared by bridge plugins that connect an external tool to an MCP harness.",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "xpublish": "npm run publish"
  },
  "devDependencies": {
    "@retrojb/eslint-config": "*",
    "@retrojb/typescript-config": "*",
    "eslint": "10.9.1",
    "typescript": "6.0.3"
  }
}
