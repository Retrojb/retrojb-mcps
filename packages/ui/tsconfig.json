{
  "extends": "@retrojb/typescript-config/react-library.json",
  "compilerOptions": {
    /*
     * `NodeNext` from the base config, deliberately not `bundler`.
     *
     * Under `bundler` resolution both `./styles` and `./components/x/Button` — a
     * directory — type-check clean, then emit as written and fail to resolve in
     * the consuming bundler, which is a runtime error found by whoever runs
     * Storybook rather than a compile error found here. `NodeNext` requires the
     * explicit `.js` specifier that the emitted ESM actually needs, so the
     * mistake is caught by `check-types`.
     */
    "lib": ["ES2023", "DOM", "DOM.Iterable"],

    // A browser library: DOM, no Node. Naming the two @types packages this code
    // actually uses is load-bearing — left to the default, TypeScript pulls in
    // every @types package hoisted to the workspace root, `@figma/plugin-typings`
    // included, and these components would type-check against globals they never
    // have at runtime.
    "types": ["react", "react-dom"],
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true
  },
  // tsc emits the declarations (`build:types`) and also runs as `--noEmit` for
  // `check-types`. `tsup.config.ts` stays out of `include` deliberately: it sits
  // beside `src` rather than in it, so including it would break `rootDir`.
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
