{
  "extends": "@retrojb/typescript-config/react-library.json",
  "compilerOptions": {
    // A browser library: DOM, no Node. `types: []` rather than the default is
    // load-bearing — without it TypeScript pulls in every @types package hoisted
    // to the workspace root, `@figma/plugin-typings` included, and these
    // components would type-check against globals they never have at runtime.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["react", "react-dom"],
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true
  },
  // tsup emits the declarations; tsc is only ever run here as `--noEmit` for
  // `check-types`. `tsup.config.ts` stays out of `include` deliberately: it sits
  // beside `src` rather than in it, so including it would break `rootDir`.
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
