{
  "name": "@retrojb/tokens",
  "version": "0.0.0",
  "description": "Design tokens for @retrojb/ui as CSS custom properties: colour ramps, semantic colours, spacing, radii, borders and type, with light and dark themes.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Retrojb/retrojb-mcps",
  "repository": {
    "type": "git",
    "url": "https://github.com/Retrojb/retrojb-mcps"
  },
  "bugs": {
    "url": "https://github.com/Retrojb/retrojb-mcps",
    "email": "jbaltes89@gmail.com"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "style": "./dist/index.css",
  "exports": {
    ".": "./dist/index.css",
    "./index.css": "./dist/index.css",
    "./light.css": "./dist/light.css",
    "./dark.css": "./dist/dark.css",
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@retrojb/eslint-config": "*",
    "eslint": "10.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
