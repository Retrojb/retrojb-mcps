{
  "name": "@retrojb/wcag-a11y-scanner",
  "version": "0.0.0",
  "description": "MCP server that applies WCAG 2 guidelines for color contrast, screen reader support, and keyboard/tab navigation.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/Retrojb/retrojb-mcps",
  "bugs": {
    "url": "https://github.com/Retrojb/retrojb-mcps",
    "email": "jbaltes89@gmail.com"
  },
  "repository": {
    "type": "github",
    "url": "git+https://github.com/Retrojb/retrojb-mcps"
  },
  "keywords": [
    "mcp",
    "accessibility",
    "a11y",
    "wcag",
    "color-contrast"
  ],
  "bin": {
    "wcag-a11y-scanner": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "start": "node dist/bin.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/bin.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@retrojb/workspace-tools": "*",
    "node-html-parser": "9.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@retrojb/eslint-config": "*",
    "@retrojb/typescript-config": "*",
    "@types/node": "26.3.0",
    "eslint": "10.9.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js"
  }
}
