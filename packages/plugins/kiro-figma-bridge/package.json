{
  "name": "@retrojb/kiro-figma-bridge",
  "version": "0.1.0",
  "description": "Connects an IDE AI agent (Kiro, Claude Code, Cursor, Codex) to live Figma content: a publishable Figma plugin plus a local WebSocket bridge exposed to the agent over MCP, authenticated with a pairing code derived from FIGMA_ACCESS_TOKEN.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Retrojb/retrojb-mcps",
  "repository": {
    "type": "git",
    "url": "https://github.com/Retrojb/retrojb-mcps"
  },
  "bugs": {
    "url": "https://github.com/Retrojb/retrojb-mcps",
    "email": "jbaltes89@gmail.com"
  },
  "keywords": [
    "figma",
    "figma-plugin",
    "mcp",
    "bridge",
    "kiro",
    "websocket"
  ],
  "bin": {
    "kiro-figma-bridge": "dist/server/bin.js"
  },
  "scripts": {
    "build": "tsc && node build.mjs",
    "build:plugin": "node build.mjs",
    "dev": "node build.mjs --watch",
    "start": "node dist/server/bin.js",
    "pair:code": "node dist/server/bin.js --print-pair-code",
    "inspect": "npx @modelcontextprotocol/inspector node dist/server/bin.js",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.sandbox.json && tsc --noEmit -p tsconfig.ui.json",
    "test": "node --test tests/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "ws": "8.21.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.136.0",
    "@retrojb/plugin-kit": "*",
    "@retrojb/typescript-config": "*",
    "@types/node": "26.3.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.27.7",
    "typescript": "6.0.3"
  },
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server/mcp.js",
    "./protocol": "./dist/shared/protocol.js"
  },
  "engines": {
    "node": ">=24"
  }
}
